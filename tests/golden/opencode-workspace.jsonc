{
  "mcp": {
    "servers": {
      "docs": {
        "type": "remote",
        "url": "https://docs.example.test/mcp",
        "headers": {
          "Authorization": "{env:DOCS_TOKEN}"
        }
      },
      "scan": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "example-security-mcp"
        ],
        "environment": {
          "EXAMPLE_TOKEN": "{env:EXAMPLE_TOKEN}"
        }
      }
    }
  }
}
