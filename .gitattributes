# `tests/golden/builder-python.md` is compared with a fresh render byte for
# byte. A checkout that rewrites it to CRLF (a Windows machine with
# core.autocrlf=true) would fail on a clean clone, so it is pinned to LF.
/tests/golden/** text eol=lf

# The source tree and every generated file are compared byte for byte, so a
# checkout that rewrites them to CRLF would report drift the source never
# declared. They are pinned to LF below, and these are the same patterns
# `farna-bootstrapper init` merges into a consumer repository's own
# .gitattributes.
/.farna/** text eol=lf
/.claude/agents/** text eol=lf
/.opencode/agents/** text eol=lf
/.opencode/commands/** text eol=lf
/.opencode/skills/** text eol=lf
/.opencode/plugins/** text eol=lf
/opencode.jsonc text eol=lf
/.farna/lock.json text eol=lf
