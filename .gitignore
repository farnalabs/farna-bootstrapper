# CI test report
vitest-report.json

# `npm pack` output, never committed
*.tgz

# The published-tarball gate moves `dist/` aside under this prefix and holds a
# lock while it packs. A killed run can leave one behind; it is never committed.
dist.farna-pack-gate-*
dist.farna-pack-gate.lock
