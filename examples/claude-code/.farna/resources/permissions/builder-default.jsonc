// A builder may read, write and run shell commands; it may not hand work to a
// subagent. `allow` entries emit nothing on Claude Code (the default is a
// deny-list), so this adds no restriction beyond the deny below.
{
  "kind": "permission",
  "id": "builder-default",
  "tools": {
    "read": "allow",
    "write": "allow",
    "edit": "allow",
    "shell": "allow",
    "task": "deny"
  },
  "patterns": {
    "shell": {
      "git push --force*": "deny"
    }
  }
}
