{
  "name": "farna-bootstrapper",
  "version": "0.1.3",
  "description": "Compile named agent personas and resources into the configuration each coding harness reads, and prove that the output still matches the source.",
  "license": "MIT",
  "author": "Farnalabs Ltd",
  "type": "module",
  "bin": {
    "farna-bootstrapper": "./dist/cli/main.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE",
    "README.md",
    "SECURITY.md"
  ],
  "engines": {
    "node": ">=22.22.0"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/farnalabs/farna-bootstrapper.git"
  },
  "homepage": "https://github.com/farnalabs/farna-bootstrapper#readme",
  "bugs": {
    "url": "https://github.com/farnalabs/farna-bootstrapper/issues"
  },
  "keywords": [
    "agents",
    "agent-configuration",
    "agent-personas",
    "claude-code",
    "opencode",
    "codegen",
    "configuration"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "prepack": "npm run build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "pack": "npm pack --dry-run",
    "publish-check": "npm publish --dry-run",
    "assert-pack": "node scripts/assert-pack.mjs"
  },
  "dependencies": {
    "commander": "15.1.0",
    "jsonc-parser": "3.3.1",
    "rulesync": "43.14.0",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.5",
    "@types/node": "22.20.5",
    "typescript": "5.9.3",
    "vitest": "5.1.1"
  }
}
