{
  // Both supported targets, agent mode: every persona is live on each target, so
  // each target emits one whole file per persona - `.claude/agents/<id>.md` and
  // `.opencode/agents/<id>.md`. The same `.farna/` source drives both, and
  // `check` in CI proves both still match it.
  "schemaVersion": 1,
  "targets": {
    "claudecode": {},
    "opencode": {}
  },
  "models": {
    "standard": {
      "claudecode": "claude-sonnet-4-5",
      "opencode": "anthropic/claude-sonnet-4-5"
    }
  }
}
